{
  "name": "aor-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:database": "node scripts/test-foundation.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.4",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
